# Copy to backend/.env (gitignored) and fill in.

# Your RuneScape name. Tools use it when you say "my stats" without naming an account.
OSRS_DEFAULT_RSN=

# Contact info for the User-Agent header (the OSRS Wiki asks API users to include one).
# e.g. "@yourname on Discord" or an email address.
GIELINOR_GUIDE_CONTACT=
