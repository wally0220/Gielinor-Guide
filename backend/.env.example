# Copy to backend/.env (gitignored) and fill in.

# Your RuneScape name. Tools use it when you say "my stats" without naming an account.
OSRS_DEFAULT_RSN=

# Contact info for the User-Agent header (the OSRS Wiki asks API users to include one).
# e.g. "@yourname on Discord" or an email address.
GIELINOR_GUIDE_CONTACT=

# Optional overrides (defaults shown).
# Where the RuneLite "Data Export" plugin writes container_*.json files.
# RUNELITE_EXPORT_DIR=~/.runelite/Data Exports
# Where local history (SQLite snapshots) is stored. Never inside the repo.
# GIELINOR_GUIDE_DATA_DIR=~/.local/share/gielinor-guide
